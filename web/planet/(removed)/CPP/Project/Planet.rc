/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\Planet.ico"
IDR_PLANETTYPE          ICON    DISCARDABLE     "res\\PlanetDoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP  MOVEABLE PURE   "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR DISCARDABLE  16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_COMMAND_TEXTURES
    SEPARATOR
    BUTTON      ID_COMMAND_SETTINGS
    BUTTON      ID_COMMAND_COMPILE
    BUTTON      ID_COMMAND_RENDER
    SEPARATOR
    BUTTON      ID_COMMAND_ANIMATE
    BUTTON      ID_COMMAND_SPINCW
    BUTTON      ID_COMMAND_SPINCCW
    SEPARATOR
    BUTTON      ID_AUTOCOMPILE
    BUTTON      ID_AUTORENDER
    SEPARATOR
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",                        ID_FILE_NEW
        MENUITEM "&Open...",                    ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   ID_APP_ABOUT
    END
END

IDR_PLANETTYPE MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",                        ID_FILE_NEW
        MENUITEM "&Open...",                    ID_FILE_OPEN
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "&Save",                       ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo",                       ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t",                        ID_EDIT_CUT
        MENUITEM "&Copy",                       ID_EDIT_COPY
        MENUITEM "&Paste",                      ID_EDIT_PASTE
    END
    POPUP "&Command"
    BEGIN
        MENUITEM "Planet &Settings...",         ID_COMMAND_SETTINGS
        MENUITEM "&Textures...",                ID_COMMAND_TEXTURES
        MENUITEM SEPARATOR
        MENUITEM "&Compile",                    ID_COMMAND_COMPILE
        MENUITEM "&Render",                     ID_COMMAND_RENDER
        MENUITEM "&Animate",                    ID_COMMAND_ANIMATE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&New Window",                 ID_WINDOW_NEW
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile",                       ID_WINDOW_TILE_HORZ
        MENUITEM "&Arrange Icons",              ID_WINDOW_ARRANGE
        MENUITEM SEPARATOR
        MENUITEM "&Match Size",                 ID_WINDOW_MATCH
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 156, 68
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Planet"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,4,4,21,20
    LTEXT           "Planet Version 1.0",IDC_STATIC,32,4,119,8,SS_NOPREFIX
    LTEXT           "Copyright © 2001 Dave Wellsted",IDC_STATIC,32,16,119,8
    DEFPUSHBUTTON   "OK",IDOK,62,52,32,14,WS_GROUP
    LTEXT           "Based on code by some other dude, whose name I can't recall...",
                    IDC_STATIC,32,28,120,20
END

IDD_PLANETDLG DIALOGEX 0, 0, 188, 124
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Planet Settings"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Tilt",IDC_STATIC,4,4,28,8
    EDITTEXT        IDC_XROT,4,16,64,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_YROT,4,48,64,14,ES_AUTOHSCROLL
    LTEXT           "Size",IDC_STATIC,4,68,24,8
    COMBOBOX        IDC_PLANETSIZE,4,80,64,84,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,4,104,64,14
    CONTROL         "",IDC_IMAGE,"Static",SS_BLACKFRAME,76,4,108,96,
                    WS_EX_CLIENTEDGE
    PUSHBUTTON      "Select &Texture...",IDC_TEXTURE,76,104,108,14
    LTEXT           "Swivel",IDC_STATIC,4,36,22,8
END

IDD_TEXDLG DIALOGEX 0, 0, 224, 164
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Textures"
FONT 8, "MS Sans Serif"
BEGIN
    COMBOBOX        IDC_NAMES,4,4,164,156,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,172,4,50,14
    CONTROL         "",IDC_PREVIEW,"Static",SS_BLACKFRAME,4,20,96,88,
                    WS_EX_CLIENTEDGE
    PUSHBUTTON      "&Curve",IDC_CURVE,4,112,48,14
    PUSHBUTTON      "&Import",IDC_IMPORT,56,112,44,14
    PUSHBUTTON      "&Band",IDC_BAND,4,128,48,14
    PUSHBUTTON      "&Rename",IDC_RENAME,56,128,44,14
    PUSHBUTTON      "&Palette",IDC_PALETTE,4,144,48,14
    PUSHBUTTON      "Dele&te",IDC_DELETE,56,144,44,14
    LTEXT           "Number of Fractures:",IDC_STATIC,112,36,67,8
    LTEXT           "Base",IDC_STATIC,120,52,27,8
    EDITTEXT        IDC_BASE,172,49,40,14,ES_AUTOHSCROLL
    LTEXT           "Exponent",IDC_STATIC,120,68,31,8
    EDITTEXT        IDC_EXPO,172,65,40,14,ES_AUTOHSCROLL
    LTEXT           "Number of Colors",IDC_STATIC,112,88,55,8
    EDITTEXT        IDC_NUMC,172,84,40,14,ES_AUTOHSCROLL
    LTEXT           "Min Color",IDC_STATIC,120,103,30,8
    LTEXT           "Max Color",IDC_STATIC,120,118,32,8
    PUSHBUTTON      "&Generate",IDC_MAKETEX,132,140,58,14
    GROUPBOX        "Custom Texture",IDC_STATIC,104,20,116,140
    CTEXT           "Click",IDC_MINC,172,100,40,12,SS_NOPREFIX,
                    WS_EX_CLIENTEDGE
    CTEXT           "Click",IDC_MAXC,172,116,40,12,SS_NOPREFIX,
                    WS_EX_CLIENTEDGE
END

IDD_TEXTDLG DIALOGEX 0, 0, 186, 23
STYLE DS_MODALFRAME | DS_SETFOREGROUND | DS_3DLOOK | WS_POPUP | WS_CAPTION
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Input"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_TEXT,4,4,176,14,ES_AUTOHSCROLL
END


