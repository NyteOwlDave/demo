0 'TRS-80 CALCULATOR
1 CLS
5 CLEAR
7 RANDOM
10 LET T$ = "BASIC CALCULATOR"
15 LET LT = LEN (T$)
20 LET O$ = "PLUS, MINUS, TIMES, DIVIDE, PERCENT, POWER, SQUARE, RANDOM"
25 LET LO = LEN (O$)
30 LET S$ = "( +, -, *, /, %, ^, #, ? )"
35 LET LS = LEN (S$)
40 PRINT TAB((64 - LT) / 2); T$
45 PRINT TAB((64 - LO) / 2); O$
50 PRINT TAB((64 - LS) / 2); S$
55 I$ = INKEY$: IF I$ = "" THEN GOTO 55
60 IF I$ <> "+" AND I$ <> "-" AND I$ <> "*" AND I$ <> "/" AND I$ <> "%" AND I$ <> "^" AND I$ <> "#" AND I$ <> "?" THEN GOTO 300
65 FOR PR = 1 TO 2: PRINT: NEXT PR
70 IF I$ = "#" OR I$ = "?" THEN GOTO 80
75 INPUT X
80 INPUT Y
85 IF I$ = "/" AND Y = 0 THEN GOTO 400
90 IF I$ = "#" AND Y < 0 THEN GOTO 500
95 IF I$ = "?" AND Y > 32767 THEN GOTO 600
100 'RESULTS
110 IF I$ = "+" THEN LET R$ = "PLUS"
115 IF I$ = "-" THEN LET R$ = "MINUS"
120 IF I$ = "*" THEN LET R$ = "TIMES"
125 IF I$ = "/" THEN LET R$ = "DIVIDE"
130 IF I$ = "%" THEN LET R$ = "PERCENT"
135 IF I$ = "^" THEN LET R$ = "POWER OF"
140 IF I$ = "#" THEN LET R$ = "SQUARE"
145 IF I$ = "?" THEN LET R$ = "RANDOM"
150 'CALCULATIONS
155 IF I$ = "+" THEN LET Z = X + Y
160 IF I$ = "-" THEN LET Z = X - Y
165 IF I$ = "*" THEN LET Z = X * Y
170 IF I$ = "/" THEN LET Z = X / Y
175 IF I$ = "%" THEN LET Z = X * Y / 100
180 IF I$ = "^" THEN LET Z = X ^ Y
185 IF I$ = "#" THEN LET Z = SQR (Y)
190 IF I$ = "?" THEN LET Z = RND (Y)
195 FOR PR = 1 TO 2: PRINT: NEXT PR
200 'TOTALS
210 IF I$ = "#" OR I$ = "?" THEN GOTO 220
215 PRINT X;R$;Y;"=";Z: GOTO 225
220 PRINT R$;Y;"=";Z
225 GOSUB 700
230 RUN
300 '
